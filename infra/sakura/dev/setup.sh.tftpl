#!/bin/bash
# @sacloud-once
# @sacloud-desc RPG学習アプリのサーバーの初期設定（infra/sakura/dev で作る）
set -euxo pipefail
export DEBIAN_FRONTEND=noninteractive
exec > >(tee -a /var/log/rpg-setup.log) 2>&1
timedatectl set-timezone Asia/Tokyo
apt-get update && apt-get -y upgrade
ufw allow 22/tcp && ufw allow 80/tcp && ufw allow 443/tcp && ufw --force enable
# Docker
curl -fsSL https://get.docker.com | sh
usermod -aG docker ubuntu
# /opt/rpg に compose・Caddyfile・.env を置く
mkdir -p /opt/rpg
echo '${compose_gz}' | base64 -d | gunzip > /opt/rpg/compose.yaml
echo '${caddyfile_gz}' | base64 -d | gunzip > /opt/rpg/Caddyfile
echo '${dotenv_gz}' | base64 -d | gunzip > /opt/rpg/.env
chmod 600 /opt/rpg/.env
chown -R ubuntu: /opt/rpg
# 反映のコマンド rpg-deploy（3.11）、DB のバックアップと復元 rpg-db（5.3）、アクセスがないときの自動停止 rpg-idle-stop（3.13）
# スタートアップスクリプトの 10,000 文字に入らないため、GitHub（公開リポジトリ）から取り、Terraform で計算した sha256 と同じかを確かめる
%{ for name, sha in tools ~}
curl -fsSL --retry 5 '${tools_base}/rpg-${name}.sh' -o /usr/local/bin/rpg-${name}
echo '${sha}  /usr/local/bin/rpg-${name}' | sha256sum -c -
%{ endfor ~}
chmod 755 /usr/local/bin/rpg-deploy /usr/local/bin/rpg-db /usr/local/bin/rpg-idle-stop
# 5分ごとの見回りと、毎日 3:00 のバックアップ（止まっていて動けなかった日は、次に起動したときに動く）
cat > /etc/systemd/system/rpg-idle-stop.service <<'UNIT'
[Unit]
Description=RPG: stop the server when idle
[Service]
Type=oneshot
ExecStart=/usr/local/bin/rpg-idle-stop
UNIT
cat > /etc/systemd/system/rpg-idle-stop.timer <<'UNIT'
[Unit]
Description=RPG: check idle every 5 minutes
[Timer]
OnBootSec=10min
OnUnitActiveSec=5min
[Install]
WantedBy=timers.target
UNIT
cat > /etc/systemd/system/rpg-db-backup.service <<'UNIT'
[Unit]
Description=RPG: back up the database
[Service]
Type=oneshot
ExecStart=/usr/local/bin/rpg-db backup
UNIT
cat > /etc/systemd/system/rpg-db-backup.timer <<'UNIT'
[Unit]
Description=RPG: back up the database daily
[Timer]
OnCalendar=*-*-* 03:00
Persistent=true
[Install]
WantedBy=timers.target
UNIT
systemctl daemon-reload
# Tailscale（スマホから Tailscale SSH で入って rpg-deploy を打つ。3.11）。外へつなぐだけなのでパケットフィルタは変えない
curl -fsSL https://tailscale.com/install.sh | sh
%{ if tailscale_auth_key != "" ~}
tailscale up --ssh --hostname='${tailscale_hostname}' --auth-key='${tailscale_auth_key}'
%{ endif ~}
# レジストリへのログイン（root と ubuntu の両方）
echo '${registry_pass}' | docker login '${registry}' -u '${registry_user}' --password-stdin
mkdir -p /home/ubuntu/.docker && cp /root/.docker/config.json /home/ubuntu/.docker/ && chown -R ubuntu: /home/ubuntu/.docker
%{ if start ~}
# DB を起動し、オブジェクトストレージにバックアップがあれば戻してから（作り直したとき）アプリを起動する
cd /opt/rpg && docker compose pull && docker compose up -d db && rpg-db restore-if-empty && docker compose up -d
systemctl enable --now rpg-idle-stop.timer rpg-db-backup.timer
%{ endif ~}
echo 'rpg-setup done'
