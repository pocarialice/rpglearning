# compose.yaml と同じディレクトリに .env として置く（値は構築手順書の V-xx）。このファイルは Git に入れない
IMAGE=<レジストリ名>.sakuracr.jp/rpg-app:<リリース番号>
SITE_ADDRESS=rpg-dev.example.jp
APP_ENV=dev
APP_URL=https://rpg-dev.example.jp
# データベースアプライアンス（PostgreSQL）
DATABASE_URL=postgres://rpgadmin:<パスワード>@<DBのIPアドレス>:5432/rpg
DATABASE_SSL=
# ログイン（32文字以上のランダムな文字列。openssl rand -base64 48 で作る）
AUTH_SECRET=<ランダムな文字列>
# オブジェクトストレージ（S3互換）
S3_ENDPOINT=https://s3.isk01.sakurastorage.jp
S3_REGION=jp-north-1
S3_ACCESS_KEY_ID=<アクセスキー>
S3_SECRET_ACCESS_KEY=<シークレットキー>
IMPORT_BUCKET=rpg-dev-import
ASSETS_BUCKET=rpg-dev-assets
NOTIFY_BUCKET=rpg-dev-notify
# メール（SMTP）
SMTP_HOST=<SMTPサーバー>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<ユーザー>
SMTP_PASS=<パスワード>
MAIL_FROM=no-reply@example.jp
ALERT_EMAIL=<監視のお知らせを受ける人>
# AI（sakura：さくらのAI Engine / bedrock：Amazon Bedrock）
AI_PROVIDER=sakura
AI_BASE_URL=https://api.ai.sakura.ad.jp/v1
AI_API_KEY=<アカウントトークン>
MODEL_HIGH=gpt-oss-120b
MODEL_LIGHT=gpt-oss-120b
# Bedrock に戻すとき（AI_PROVIDER=bedrock）
# AWS_REGION=ap-northeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# MODEL_HIGH=<Sonnet のモデルID>
# MODEL_LIGHT=<Haiku のモデルID>
# メール送信の定期処理（dev は確認するときだけ true）
MAIL_SCHEDULE_ENABLED=false
